{
    "name": "apistolic/laravel-prod-snapshot",
    "description": "Dump a remote (production) database over an optional SSH tunnel and restore it into your local Laravel dev database. Supports MySQL and Postgres.",
    "keywords": ["laravel", "database", "mysql", "postgres", "forge", "backup", "sync"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "symfony/process": "^6.0|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Apistolic\\LaravelProdSnapshot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apistolic\\LaravelProdSnapshot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Apistolic\\LaravelProdSnapshot\\LaravelProdSnapshotServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
